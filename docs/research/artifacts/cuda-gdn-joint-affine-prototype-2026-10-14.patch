+fn check_prepared_components(
+    device: &CudaDevice,
+    input: &Tensor<f32>,
+    high: &mut Tensor<bf16>,
+    low: &mut Tensor<bf16>,
+) -> Result<(), Box<dyn std::error::Error>> {
+    let graph = CudaGraph::scope(&device.stream, |scope| {
+        scope.record(kernels::prepare_components(
+            (&mut *high).partition([1, 128]),
+            (&mut *low).partition([1, 128]),
+            input,
+        ))?;
+        Ok(())
+    })?;
+    graph.launch().sync_on(&device.stream)?;
+    let source = device.read_borrowed(input)?;
+    let hi = device.read_borrowed(high)?;
+    let lo = device.read_borrowed(low)?;
+    assert_eq!(source.len(), hi.len());
+    assert_eq!(source.len(), lo.len());
+    let mut different = 0;
+    for ((value, high), low) in source.iter().zip(&hi).zip(&lo) {
+        let expected_high = bf16::from_f32(*value);
+        let expected_low = bf16::from_f32(*value - expected_high.to_f32());
+        different += usize::from(high.to_bits() != expected_high.to_bits())
+            + usize::from(low.to_bits() != expected_low.to_bits());
+    }
+    println!(
+        "{}",
+        serde_json::json!({"prepared_component_bits":true,"elements":source.len()*2,"different":different})
+    );
+    assert_eq!(different, 0);
+    Ok(())
+}
+
+fn check_prepared_projection_bits(
+    device: &CudaDevice,
+    weights: &[CheckpointDenseWeight],
+    input: &Tensor<f32>,
+    high: &Tensor<bf16>,
+    low: &Tensor<bf16>,
+) -> Result<(), Box<dyn std::error::Error>> {
+    for (index, weight) in weights.iter().enumerate() {
+        let shape = [4, weight.outputs];
+        let old = kernels::dense(
+            api::zeros::<f32>(&shape).partition([16, 32]),
+            input,
+            &weight.device,
+        )
+        .generics(vec![
+            bf16::DTYPE.as_str().into(),
+            weight.columns.to_string(),
+        ])
+        .first()
+        .unpartition()
+        .sync_on(&device.stream)?
+        .to_host_vec()
+        .sync_on(&device.stream)?;
+        let new = kernels::dense_prepared(
+            api::zeros::<f32>(&shape).partition([16, 32]),
+            high,
+            low,
+            &weight.device,
+        )
+        .generics(vec![
+            bf16::DTYPE.as_str().into(),
+            weight.columns.to_string(),
+        ])
+        .first()
+        .unpartition()
+        .sync_on(&device.stream)?
+        .to_host_vec()
+        .sync_on(&device.stream)?;
+        assert_eq!(old.len(), new.len());
+        assert!(old.iter().chain(&new).all(|value| value.is_finite()));
+        let different = old
+            .iter()
+            .zip(&new)
+            .filter(|(left, right)| left.to_bits() != right.to_bits())
+            .count();
+        println!(
+            "{}",
+            serde_json::json!({"prepared_projection_bits":true,"weight_index":index,"elements":old.len(),"different":different})
+        );
+        assert_eq!(
+            different, 0,
+            "preparing input changed existing MMA arithmetic"
+        );
+    }
+    Ok(())
+}
