+type JointWeight = (
+    CheckpointDenseWeight,
+    CheckpointDenseWeight,
+    Arc<Tensor<bf16>>,
+);
+fn joint_checkpoint_weights(
+    device: &CudaDevice,
+) -> Result<Vec<JointWeight>, Box<dyn std::error::Error>> {
+    use infer_models::QuantizedPackage;
+    use std::collections::BTreeMap;
+    let package =
+        QuantizedPackage::open(std::env::var("INFER_TEST_MODEL")?, infer_core::ModelId::ONE)?;
+    let mut selected = BTreeMap::new();
+    for source in package.weights.values() {
+        for (part, suffix) in [
+            (0, ".linear_attn.in_proj_a.weight"),
+            (1, ".linear_attn.in_proj_b.weight"),
+        ] {
+            if let Some(layer) = source.data.name.strip_suffix(suffix) {
+                selected
+                    .entry(layer.to_owned())
+                    .or_insert_with(BTreeMap::new)
+                    .insert(part, source);
+            }
+        }
+    }
+    let mut result = Vec::new();
+    for (layer, sources) in selected {
+        assert_eq!(sources.len(), 2, "layer {layer} alpha/beta pair");
+        let a = CheckpointDenseWeight::load(device, &package, sources[&0])?;
+        let b = CheckpointDenseWeight::load(device, &package, sources[&1])?;
+        assert_eq!((a.columns, a.outputs), (b.columns, b.outputs));
+        let packed = device.upload(
+            a.values
+                .iter()
+                .chain(&b.values)
+                .map(|v| bf16::from_f32(*v))
+                .collect(),
+            &[a.outputs + b.outputs, a.columns],
+        )?;
+        result.push((a, b, packed));
+    }
+    Ok(result)
+}
