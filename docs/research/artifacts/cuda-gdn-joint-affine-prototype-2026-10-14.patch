+fn prepared_checkpoint_weights(
+    device: &CudaDevice,
+) -> Result<Vec<CheckpointDenseWeight>, Box<dyn std::error::Error>> {
+    use infer_models::QuantizedPackage;
+    let package =
+        QuantizedPackage::open(std::env::var("INFER_TEST_MODEL")?, infer_core::ModelId::ONE)?;
+    package
+        .weights
+        .values()
+        .filter(|source| {
+            source.data.name.contains(".linear_attn.in_proj_a.weight")
+                || source.data.name.contains(".linear_attn.in_proj_b.weight")
+        })
+        .map(|source| CheckpointDenseWeight::load(device, &package, source))
+        .collect::<Result<Vec<_>, _>>()
+}
