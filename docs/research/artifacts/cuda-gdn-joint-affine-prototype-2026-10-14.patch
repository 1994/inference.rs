+fn prepared_pool_case(loaded: &LoadedModel, case: &Value, width: usize) -> Result<()> {
+    use crate::resident::{prepared_capture_counts, with_prepared};
+    let tokens: Vec<u32> = serde_json::from_value(case["tokens"].clone())
+        .map_err(|e| Error::invalid(e.to_string()))?;
+    let (seed, prompt) = prepared_pool_prefix(loaded, &tokens)?;
+    let first = greedy(
+        &prompt
+            .last()
+            .ok_or_else(|| Error::invariant("prefix output"))?
+            .1,
+    )?;
+    let mut old = with_prepared(false, || loaded.slot_pool(width, 8192))?;
+    let before = prepared_capture_counts();
+    let mut new = with_prepared(true, || loaded.slot_pool(width, 8192))?;
+    let after = prepared_capture_counts();
+    assert_eq!((after.0 - before.0, after.1 - before.1), (48, 48));
+    let vocabulary = u32::try_from(
+        prompt
+            .last()
+            .ok_or_else(|| Error::invariant("prefix output"))?
+            .1
+            .len(),
+    )
+    .map_err(|e| Error::invalid(e.to_string()))?;
+    let mut positions = vec![tokens.len(); width];
+    let mut next: Vec<u32> = (0..width)
+        .map(|slot| (first + u32::try_from(slot * 11).expect("slot")) % vocabulary)
+        .collect();
+    for slot in 0..width {
+        for pool in [&mut old, &mut new] {
+            assert_eq!(pool.take_free(), Some(slot));
+            pool.bind(
+                slot,
+                seed.states(),
+                seed.fp8_states(),
+                tokens.len(),
+                loaded.device(),
+            )?;
+        }
+        assert_eq!(
+            prepared_pool_state_bits(loaded.device(), &old, &new, slot)?,
+            0
+        );
+    }
+    for step in 0..8 {
+        if step == 5 {
+            let slot = width - 1;
+            for pool in [&mut old, &mut new] {
+                pool.release(slot);
+                assert_eq!(pool.take_free(), Some(slot));
+                pool.bind(
+                    slot,
+                    seed.states(),
+                    seed.fp8_states(),
+                    tokens.len(),
+                    loaded.device(),
+                )?;
+            }
+            positions[slot] = tokens.len();
+        }
+        let active: Vec<_> = (0..width)
+            .filter(|slot| step != 2 || slot % 2 == 0)
+            .collect();
+        let lanes: Vec<_> = active
+            .iter()
+            .map(|&slot| (slot, next[slot], positions[slot], positions[slot]))
+            .collect();
+        let a = old.run_lanes(loaded.device(), &lanes)?;
+        let b = new.run_lanes(loaded.device(), &lanes)?;
+        for ((&slot, left), right) in active.iter().zip(&a).zip(&b) {
+            let hidden = agreement(
+                &old.test_hidden(loaded.device(), slot)?,
+                &new.test_hidden(loaded.device(), slot)?,
+                "oldMMA vs prepared hidden",
+            );
+            let logits = agreement(&left.1, &right.1, "oldMMA vs prepared logits");
+            println!(
+                "{}",
+                json!({"prepared_pool_output":true,"case":case["case_id"],"width":width,"step":step,"slot":slot,"hidden":hidden,"logits":logits})
+            );
+            assert_eq!(differences(&hidden) + differences(&logits), 0);
+            next[slot] = (greedy(&left.1)? + u32::try_from(slot * 3).expect("slot")) % vocabulary;
+            positions[slot] += 1;
+        }
+        for slot in 0..width {
+            let changed = prepared_pool_state_bits(loaded.device(), &old, &new, slot)?;
+            println!(
+                "{}",
+                json!({"prepared_pool_state":true,"case":case["case_id"],"width":width,"step":step,"slot":slot,"different":changed,"complete_F32_and_FP8":true})
+            );
+            assert_eq!(changed, 0);
+        }
+    }
+    Ok(())
+}
+
+fn prepared_pool_state_bits(
+    device: &CudaDevice,
+    old: &SlotPool,
+    new: &SlotPool,
+    slot: usize,
+) -> Result<usize> {
+    let (a, af) = old.test_states(slot);
+    let (b, bf) = new.test_states(slot);
+    assert_eq!(a.len(), b.len());
+    assert_eq!(af.len(), bf.len());
+    let mut changed = 0;
+    for (id, parts) in a {
+        assert_eq!(parts.len(), b[id].len());
+        for (left, right) in parts.iter().zip(&b[id]) {
+            let x = device.read_borrowed(left)?;
+            let y = device.read_borrowed(right)?;
+            let count = agreement(&x, &y, &format!("state{id:?}"));
+            changed += differences(&count);
+            if differences(&count) > 0 {
+                println!("{count}");
+            }
+        }
+    }
+    for (id, (k, v)) in af {
+        let (rk, rv) = &bf[id];
+        for (left, right) in [(k, rk), (v, rv)] {
+            let x = device.read_borrowed(left)?;
+            let y = device.read_borrowed(right)?;
+            assert_eq!(x.len(), y.len());
+            assert!(x.iter().chain(&y).all(|n| n.0 & 127 != 127));
+            changed += x
+                .iter()
+                .zip(&y)
+                .filter(|(left, right)| left.0 != right.0)
+                .count();
+        }
+    }
+    Ok(changed)
+}
