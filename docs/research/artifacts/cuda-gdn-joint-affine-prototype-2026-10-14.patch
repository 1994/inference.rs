+            "scope":"48 actual alpha/beta pairs; 48 preparation plus 48 joint MMA plus 48 split kernels; weight packing is once at capture setup and excluded from replay",
+            "cold_l2":cold,"baseline_ms":old.median_ms(),"candidate_ms":new.median_ms(),
+            "speedup":old.median_ms()/new.median_ms(),"old_samples_ms":old.times_ms(),
+            "new_samples_ms":new.times_ms(),"service_performance_acceptance":false})
+        );
+    }
+    Ok(())
+}
