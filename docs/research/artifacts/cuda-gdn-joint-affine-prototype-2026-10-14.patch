+fn prepared_timing_pair(
+    device: &CudaDevice,
+    options: &cutile::bench::BenchOptions,
+    baseline: &CudaGraph<()>,
+    candidate: &CudaGraph<()>,
+) -> Result<(cutile::bench::Measurement, cutile::bench::Measurement), Box<dyn std::error::Error>> {
+    let run = |graph: &CudaGraph<()>| {
+        graph
+            .launch()
+            .sync_on(&device.stream)
+            .map_err(|error| cutile::error::tensor_error(&error.to_string()))
+    };
+    if std::env::var("INFER_TEST_PREPARED_CANDIDATE_FIRST").is_ok_and(|value| value == "1") {
+        let (new, old) = cutile::bench::do_bench_paired(
+            &device.stream,
+            options,
+            |_| run(candidate),
+            |_| run(baseline),
+        )?;
+        Ok((old, new))
+    } else {
+        Ok(cutile::bench::do_bench_paired(
+            &device.stream,
+            options,
+            |_| run(baseline),
+            |_| run(candidate),
+        )?)
+    }
+}
