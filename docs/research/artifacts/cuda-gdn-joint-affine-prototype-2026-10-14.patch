+//! Prepared two-component BF16 inputs retained across slot-graph replays.
+use super::{ProgramWeights, capture::error, small_gemm::kernels};
+use crate::{
+    device::{CudaDevice, device_error},
+    mlp::ProjectionWeight,
+};
+use cutile::{half::bf16, prelude::*};
+use infer_core::{Error, Result, TensorId};
+use infer_ir::{DataflowGraph, TensorNode, TensorOp};
+use std::collections::{BTreeMap, BTreeSet};
+
+struct Pair {
+    high: Tensor<bf16>,
+    low: Tensor<bf16>,
+    input: Option<TensorId>,
+}
+#[derive(Default)]
+pub(super) struct Workspace {
+    pairs: BTreeMap<usize, Pair>,
+    joint: super::small_gemm_joint::Workspace,
+}
+impl Workspace {
+    pub(super) fn new(
+        device: &CudaDevice,
+        graph: &DataflowGraph,
+        weights: &ProgramWeights,
+        rows: usize,
+        arena_bytes: usize,
+    ) -> Result<Self> {
+        #[cfg(test)]
+        if !ENABLED.with(std::cell::Cell::get) {
+            return Ok(Self::default());
+        }
+        let sizes: BTreeMap<_, _> = graph
+            .tensors
+            .iter()
+            .map(|t| Ok((t.id, t.elements()?)))
+            .collect::<Result<_>>()?;
+        let mut columns = BTreeSet::new();
+        for node in &graph.nodes {
+            if node.op != TensorOp::Linear
+                || !matches!(
+                    weights.projections.get(&node.inputs[1]),
+                    Some(ProjectionWeight::Dense(_))
+                )
+                || weights.activation_quantization(node.inputs[1]).is_some()
+            {
+                continue;
+            }
+            let k = sizes[&node.inputs[0]];
+            if k > 0
+                && sizes[&node.outputs[0]]
+                    <= k.saturating_mul(crate::constants::GEMV_WIDE_OUTPUT_RATIO)
+            {
+                columns.insert(k);
+            }
+        }
+        let bytes = columns.iter().try_fold(arena_bytes, |total, &k| {
+            k.checked_mul(rows)
+                .and_then(|n| n.checked_mul(crate::constants::F32_BYTES))
+                .and_then(|n| total.checked_add(n))
+                .ok_or_else(|| Error::invalid("prepared projection workspace overflow"))
+        })?;
+        if u64::try_from(bytes).map_err(device_error)? > device.profile()?.arena_budget_bytes() {
+            return Ok(Self::default());
+        }
+        let mut pairs = BTreeMap::new();
+        for k in columns {
+            pairs.insert(
+                k,
+                Pair {
+                    high: api::zeros::<bf16>(&[rows, k])
+                        .sync_on(&device.stream)
+                        .map_err(device_error)?,
+                    low: api::zeros::<bf16>(&[rows, k])
+                        .sync_on(&device.stream)
+                        .map_err(device_error)?,
+                    input: None,
+                },
+            );
+        }
+        let joint = super::small_gemm_joint::Workspace::new(device, graph, weights, rows, bytes)?;
+        Ok(Self { pairs, joint })
+    }
+    pub(super) fn record_joint(
+        &mut self,
+        scope: &Scope,
+        node: &TensorNode,
+        arena: &mut super::ActivationArena,
+    ) -> std::result::Result<bool, DeviceError> {
+        #[cfg(test)]
+        if super::small_gemm::precise_dense_enabled() || super::small_gemm::pool_f32_enabled() {
+            return Ok(false);
+        }
+        self.joint.record(scope, node, arena)
+    }
+    pub(super) fn begin_capture(&mut self) {
+        for pair in self.pairs.values_mut() {
+            pair.input = None;
+        }
+    }
+    pub(super) fn record(
+        &mut self,
+        scope: &Scope,
+        node: &TensorNode,
+        weights: &ProgramWeights,
+        input: &TensorView<'_, f32>,
+        output: &mut Tensor<f32>,
+    ) -> std::result::Result<bool, DeviceError> {
+        #[cfg(test)]
+        if super::small_gemm::precise_dense_enabled() || super::small_gemm::pool_f32_enabled() {
+            return Ok(false);
+        }
+        let k = usize::try_from(input.shape()[1]).map_err(error)?;
+        let Some(pair) = self.pairs.get_mut(&k) else {
+            return Ok(false);
+        };
+        if weights.activation_quantization(node.inputs[1]).is_some() {
+            return Ok(false);
+        }
+        let rows = usize::try_from(input.shape()[0]).map_err(error)?;
+        if output.size() / rows > k.saturating_mul(crate::constants::GEMV_WIDE_OUTPUT_RATIO) {
+            return Ok(false);
+        }
+        let Some(ProjectionWeight::Dense(weight)) = weights.projections.get(&node.inputs[1]) else {
+            return Ok(false);
+        };
+        if pair.input != Some(node.inputs[0]) {
+            scope.record(kernels::prepare_components(
+                (&mut pair.high).partition([1, 128]),
+                (&mut pair.low).partition([1, 128]),
+                input,
+            ))?;
+            pair.input = Some(node.inputs[0]);
+            #[cfg(test)]
+            PREPARES.with(|n| n.set(n.get() + 1));
+        }
+        scope.record(
+            kernels::dense_prepared(
+                output.partition(crate::constants::SMALL_GEMM_TILE),
+                &pair.high,
+                &pair.low,
+                weight,
+            )
+            .generics(vec![bf16::DTYPE.as_str().into(), k.to_string()]),
+        )?;
+        #[cfg(test)]
+        MMAS.with(|n| n.set(n.get() + 1));
+        Ok(true)
+    }
+}
+#[cfg(test)]
+thread_local! {
+    static ENABLED: std::cell::Cell<bool> = const { std::cell::Cell::new(true) };
+    static PREPARES: std::cell::Cell<usize> = const { std::cell::Cell::new(0) };
+    static MMAS: std::cell::Cell<usize> = const { std::cell::Cell::new(0) };
+}
+#[cfg(test)]
+pub fn with_prepared<T>(enabled: bool, run: impl FnOnce() -> T) -> T {
+    struct Restore(bool);
+    impl Drop for Restore {
+        fn drop(&mut self) {
+            ENABLED.with(|cell| cell.set(self.0));
+        }
+    }
+    let restore = Restore(ENABLED.with(|cell| cell.replace(enabled)));
+    let result = run();
+    drop(restore);
+    result
+}
+#[cfg(test)]
+pub fn capture_counts() -> (usize, usize) {
+    (
+        PREPARES.with(std::cell::Cell::get),
+        MMAS.with(std::cell::Cell::get),
+    )
+}
+
+#[cfg(test)]
+pub(super) fn note_joint() {
+    PREPARES.with(|n| n.set(n.get() + 1));
+    MMAS.with(|n| n.set(n.get() + 1));
+}
