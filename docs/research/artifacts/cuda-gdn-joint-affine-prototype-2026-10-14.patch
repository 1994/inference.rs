+#[expect(
+    clippy::too_many_arguments,
+    reason = "isolated captured replay includes all preparation and output copies"
+)]
+fn joint_projection_graph(
+    device: &CudaDevice,
+    input: &Tensor<f32>,
+    high: &mut Tensor<bf16>,
+    low: &mut Tensor<bf16>,
+    joint: &mut Tensor<f32>,
+    first: &mut Tensor<f32>,
+    second: &mut Tensor<f32>,
+    packed: &[Arc<Tensor<bf16>>],
+) -> Result<CudaGraph<()>, DeviceError> {
+    let columns = usize::try_from(input.shape()[1]).map_err(super::super::capture::error)?;
+    let rows = usize::try_from(input.shape()[0]).map_err(super::super::capture::error)?;
+    let outputs = first.size() / rows;
+    CudaGraph::scope(&device.stream, |scope| {
+        for weight in packed {
+            scope.record(kernels::prepare_components(
+                (&mut *high).partition([1, 128]),
+                (&mut *low).partition([1, 128]),
+                input,
+            ))?;
+            scope.record(
+                kernels::dense_prepared((&mut *joint).partition([16, 32]), &*high, &*low, weight)
+                    .generics(vec![bf16::DTYPE.as_str().into(), columns.to_string()]),
+            )?;
+            let a = joint
+                .slice(&[0..rows, 0..outputs])
+                .map_err(super::super::capture::error)?;
+            let b = joint
+                .slice(&[0..rows, outputs..outputs * 2])
+                .map_err(super::super::capture::error)?;
+            scope.record(kernels::split_joint(
+                (&mut *first).partition([1, 64]),
+                (&mut *second).partition([1, 64]),
+                &a,
+                &b,
+            ))?;
+        }
+        Ok(())
+    })
+}
+
+fn check_joint_projection_bits(
+    device: &CudaDevice,
+    pairs: &[JointWeight],
+) -> Result<(), Box<dyn std::error::Error>> {
+    let columns = pairs[0].0.columns;
+    let outputs = pairs[0].0.outputs;
+    assert_eq!(outputs, 48);
+    let mut first = api::zeros::<f32>(&[4, outputs]).sync_on(&device.stream)?;
+    let mut second = api::zeros::<f32>(&[4, outputs]).sync_on(&device.stream)?;
+    let mut joint = api::zeros::<f32>(&[4, outputs * 2]).sync_on(&device.stream)?;
+    let mut high = api::zeros::<bf16>(&[4, columns]).sync_on(&device.stream)?;
+    let mut low = api::zeros::<bf16>(&[4, columns]).sync_on(&device.stream)?;
+    for fixture in ["zero", "ordinary", "sparse", "wide_exponent"] {
+        let input = device.upload(checkpoint_small_input(columns, fixture), &[4, columns])?;
+        check_prepared_components(device, &input, &mut high, &mut low)?;
+        for (index, (a, b, packed)) in pairs.iter().enumerate() {
+            let original = CudaGraph::scope(&device.stream, |scope| {
+                for (target, weight) in [(&mut first, a), (&mut second, b)] {
+                    scope.record(
+                        kernels::dense(target.partition([16, 32]), &input, &weight.device)
+                            .generics(vec![bf16::DTYPE.as_str().into(), columns.to_string()]),
+                    )?;
+                }
+                Ok(())
+            })?;
+            original.launch().sync_on(&device.stream)?;
+            let a_values = device.read_borrowed(&first)?;
+            let b_values = device.read_borrowed(&second)?;
+            let candidate = joint_projection_graph(
+                device,
+                &input,
+                &mut high,
+                &mut low,
+                &mut joint,
+                &mut first,
+                &mut second,
+                std::slice::from_ref(packed),
+            )?;
+            candidate.launch().sync_on(&device.stream)?;
+            let new_a = device.read_borrowed(&first)?;
+            let new_b = device.read_borrowed(&second)?;
+            assert!(
+                a_values
+                    .iter()
+                    .chain(&b_values)
+                    .chain(&new_a)
+                    .chain(&new_b)
+                    .all(|v| v.is_finite())
+            );
+            let different = a_values
+                .iter()
+                .chain(&b_values)
+                .zip(new_a.iter().chain(&new_b))
+                .filter(|(old, new)| old.to_bits() != new.to_bits())
+                .count();
+            println!(
+                "{}",
+                serde_json::json!({"joint_projection_bits":true,
+                "pair_index":index,"fixture":fixture,"elements":a_values.len()+b_values.len(),
+                "different":different,"columns":columns,"outputs":outputs})
+            );
+            assert_eq!(
+                different, 0,
+                "joint projection changed existing MMA arithmetic"
+            );
+        }
+    }
+    Ok(())
+}
