+fn prepared_pool_prefix(
+    loaded: &LoadedModel,
+    tokens: &[u32],
+) -> Result<(DeviceProgram, crate::resident::BatchOutput)> {
+    let capacity = tokens
+        .len()
+        .checked_add(64)
+        .ok_or_else(|| Error::invalid("prefix capacity overflow"))?;
+    let mut seed = loaded.sequence(capacity)?;
+    let mut prompt = Vec::new();
+    for (chunk, input) in tokens.chunks(64).enumerate() {
+        let position = chunk * 64;
+        prompt = seed.prefill_batch(input, position, position + input.len() == tokens.len())?;
+    }
+    Ok((seed, prompt))
+}
