+            for (target, weight) in [(&mut first, a), (&mut second, b)] {
+                scope.record(
+                    kernels::dense(target.partition([16, 32]), &input, &weight.device)
+                        .generics(vec![bf16::DTYPE.as_str().into(), columns.to_string()]),
+                )?;
+            }
+        }
+        Ok(())
+    })?;
+    let packed: Vec<_> = pairs.iter().map(|(_, _, p)| Arc::clone(p)).collect();
+    let candidate = joint_projection_graph(
+        &device,
+        &input,
+        &mut high,
+        &mut low,
+        &mut joint,
+        &mut first,
+        &mut second,
+        &packed,
+    )?;
+    for cold in [true, false] {
+        let options = BenchOptions {
+            warmup: Duration::from_millis(50),
+            rep: Duration::from_millis(150),
+            min_reps: 20,
+            max_reps: 100,
+            clear_l2: cold,
+        };
+        let (old, new) = prepared_timing_pair(&device, &options, &baseline, &candidate)?;
+        println!(
+            "{}",
