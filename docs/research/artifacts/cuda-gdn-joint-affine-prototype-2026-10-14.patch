+//! Adjacent dense projections share one prepared input and one MMA launch.
+//! The original tile and accumulation order are retained for both outputs.
+use super::{ActivationArena, ProgramWeights, capture::error, small_gemm::kernels};
+use crate::{
+    device::{CudaDevice, device_error},
+    mlp::ProjectionWeight,
+};
+use cutile::{half::bf16, prelude::*};
+use infer_core::{Error, OpId, Result, TensorId};
+use infer_ir::{DataflowGraph, TensorNode, TensorOp};
+use std::collections::{BTreeMap, BTreeSet};
+
+struct Joint {
+    weight: Tensor<bf16>,
+    output_ids: [TensorId; 2],
+    columns: usize,
+    outputs: usize,
+}
+struct Buffers {
+    high: Tensor<bf16>,
+    low: Tensor<bf16>,
+    joint: Tensor<f32>,
+}
+struct Plan {
+    first: OpId,
+    second: OpId,
+    weights: [TensorId; 2],
+    outputs: [TensorId; 2],
+    columns: usize,
+    output_columns: usize,
+}
+#[derive(Default)]
+pub(super) struct Workspace {
+    joints: BTreeMap<OpId, Joint>,
+    seconds: BTreeSet<OpId>,
+    buffers: BTreeMap<(usize, usize), Buffers>,
+}
+impl Workspace {
+    pub(super) fn new(
+        device: &CudaDevice,
+        graph: &DataflowGraph,
+        weights: &ProgramWeights,
+        rows: usize,
+        arena_bytes: usize,
+    ) -> Result<Self> {
+        if !(2..=crate::constants::CB_DECODE_SLOTS).contains(&rows) {
+            return Ok(Self::default());
+        }
+        let plans = plans(graph, weights)?;
+        let mut shapes = BTreeSet::new();
+        let bytes = plans.iter().try_fold(arena_bytes, |sum, p| {
+            let weight_bytes = p
+                .columns
+                .checked_mul(p.output_columns)
+                .and_then(|n| n.checked_mul(4));
+            let buffer_bytes = if shapes.insert((p.columns, p.output_columns)) {
+                p.columns
+                    .checked_add(
+                        p.output_columns
+                            .checked_mul(2)
+                            .ok_or_else(|| Error::invalid("joint output size"))?,
+                    )
+                    .and_then(|n| n.checked_mul(rows))
+                    .and_then(|n| n.checked_mul(4))
+            } else {
+                Some(0)
+            };
+            weight_bytes
+                .and_then(|n| buffer_bytes.and_then(|b| n.checked_add(b)))
+                .and_then(|n| sum.checked_add(n))
+                .ok_or_else(|| Error::invalid("joint projection workspace overflow"))
+        })?;
+        if u64::try_from(bytes).map_err(device_error)? > device.profile()?.arena_budget_bytes() {
+            return Ok(Self::default());
+        }
+        let mut result = Self::default();
+        for (columns, outputs) in shapes {
+            result.buffers.insert(
+                (columns, outputs),
+                Buffers {
+                    high: api::zeros::<bf16>(&[rows, columns])
+                        .sync_on(&device.stream)
+                        .map_err(device_error)?,
+                    low: api::zeros::<bf16>(&[rows, columns])
+                        .sync_on(&device.stream)
+                        .map_err(device_error)?,
+                    joint: api::zeros::<f32>(&[rows, outputs * 2])
+                        .sync_on(&device.stream)
+                        .map_err(device_error)?,
+                },
+            );
+        }
+        for p in plans {
+            let Some(ProjectionWeight::Dense(a)) = weights.projections.get(&p.weights[0]) else {
+                return Err(Error::invariant("joint first dense weight"));
+            };
+            let Some(ProjectionWeight::Dense(b)) = weights.projections.get(&p.weights[1]) else {
+                return Err(Error::invariant("joint second dense weight"));
+            };
+            let weight = kernels::join_weights(
+                api::zeros::<bf16>(&[p.output_columns * 2, p.columns]).partition([1, 128]),
+                a,
+                b,
+            )
+            .generics(vec![p.output_columns.to_string(), p.columns.to_string()])
+            .first()
+            .unpartition()
+            .sync_on(&device.stream)
+            .map_err(device_error)?;
+            result.joints.insert(
+                p.first,
+                Joint {
+                    weight,
+                    output_ids: p.outputs,
+                    columns: p.columns,
+                    outputs: p.output_columns,
+                },
+            );
+            result.seconds.insert(p.second);
+        }
+        Ok(result)
+    }
+    pub(super) fn record(
+        &mut self,
+        scope: &Scope,
+        node: &TensorNode,
+        arena: &mut ActivationArena,
+    ) -> std::result::Result<bool, DeviceError> {
+        if self.seconds.contains(&node.id) {
+            return Ok(true);
+        }
+        let Some(joint) = self.joints.get(&node.id) else {
+            return Ok(false);
+        };
+        let rows = arena.lanes();
+        let slots = [
+            arena.slot(joint.output_ids[0]).map_err(error)?,
+            arena.slot(joint.output_ids[1]).map_err(error)?,
+        ];
+        if slots[0] == slots[1] || slots.contains(&arena.slot(node.inputs[0]).map_err(error)?) {
+            return Err(error("joint projection aliases a live input or output"));
+        }
+        let mut outputs = Vec::new();
+        for &slot in &slots {
+            outputs.push(
+                arena.buffers[slot]
+                    .take()
+                    .ok_or_else(|| error("joint output"))?
+                    .reshape(&[rows, joint.outputs])
+                    .map_err(error)?,
+            );
+        }
+        let input = arena
+            .get(node.inputs[0])
+            .map_err(error)?
+            .view(&[rows, joint.columns])
+            .map_err(error)?;
+        let buffers = self
+            .buffers
+            .get_mut(&(joint.columns, joint.outputs))
+            .ok_or_else(|| error("joint buffers"))?;
+        scope.record(kernels::prepare_components(
+            (&mut buffers.high).partition([1, 128]),
+            (&mut buffers.low).partition([1, 128]),
+            &input,
+        ))?;
+        scope.record(
+            kernels::dense_prepared(
+                (&mut buffers.joint).partition(crate::constants::SMALL_GEMM_TILE),
+                &buffers.high,
+                &buffers.low,
+                &joint.weight,
+            )
+            .generics(vec![bf16::DTYPE.as_str().into(), joint.columns.to_string()]),
+        )?;
+        let a = buffers
+            .joint
+            .slice(&[0..rows, 0..joint.outputs])
+            .map_err(error)?;
+        let b = buffers
+            .joint
+            .slice(&[0..rows, joint.outputs..joint.outputs * 2])
+            .map_err(error)?;
+        let [first, second] = outputs.as_mut_slice() else {
+            return Err(error("joint output count"));
+        };
+        scope.record(kernels::split_joint(
+            first.partition([1, 64]),
+            second.partition([1, 64]),
+            &a,
+            &b,
+        ))?;
+        for (slot, output) in slots.into_iter().zip(outputs) {
+            arena.buffers[slot] = Some(output.reshape(&[rows * joint.outputs]).map_err(error)?);
+        }
+        #[cfg(test)]
+        super::small_gemm_prepared::note_joint();
+        Ok(true)
+    }
+}
+fn plans(graph: &DataflowGraph, weights: &ProgramWeights) -> Result<Vec<Plan>> {
+    let sizes: BTreeMap<_, _> = graph
+        .tensors
+        .iter()
+        .map(|t| Ok((t.id, t.elements()?)))
+        .collect::<Result<_>>()?;
+    let mut result = Vec::new();
+    let mut claimed = BTreeSet::new();
+    for pair in graph.nodes.windows(2) {
+        let a = &pair[0];
+        let b = &pair[1];
+        if claimed.contains(&a.id) || claimed.contains(&b.id) {
+            continue;
+        }
+        if a.op != TensorOp::Linear
+            || b.op != TensorOp::Linear
+            || a.inputs[0] != b.inputs[0]
